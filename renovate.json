{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "custom.jsonata",
    "pip_requirements"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/tools/browser-compatibility/**",
    ".github/cosign/**"
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)([^/]*[-_])?requirements[^/]*\\.(txt|pip)$/"
    ]
  },
  "packageRules": [
    {
      "description": "This named compatibility target deliberately exercises HA 2026.10.0 and its matching dependency pins; current HA updates belong in requirements-runtime.txt.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "requirements-runtime-2026.10.0.txt"
      ],
      "enabled": false
    }
  ]
}
